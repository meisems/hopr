# Hopr bot — every secret and API key the worker uses.
#
# Local dev: copy to .dev.vars (git-ignored) and fill in; `npx wrangler dev` reads it.
# Production: set each with `npx wrangler secret put <NAME>` (never commit real values).
# After deploying, GET /health lists which of these are configured (true/false only).

# --- Required -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_WEBHOOK_SECRET=       # openssl rand -hex 32 (also passed to setWebhook)
ENCRYPTION_KEY=                # 32+ random bytes; encrypts every wallet key. Never rotate without migrating keys.

# --- Transactions & quotes (strongly recommended in production) --------------
LIFI_API_KEY=                  # LI.FI partner key: quotes for every EVM/Solana trade. Without it all users share an anonymous quota.
ONECLICK_JWT=                  # NEAR Intents 1Click key: cross-chain NEAR routes (default 50/50 app-fee split)
HOPR_INTENTS_FEE_ACCOUNT=      # Hopr's NEAR account that receives NEAR Intents / Ref Finance fees

# --- Keyed RPCs: used FIRST for balances, portfolio and sending transactions ---
# Public backups (verified) stay behind these, so the bot keeps working if a key runs out.
ALCHEMY_API_KEY=               # one key covers Base, Arbitrum, BNB Chain and Solana + EVM token discovery for 💼 Portfolio
HELIUS_API_KEY=                # Solana reads, token discovery and transaction sending (recommended: few public Solana RPCs list tokens)
NEAR_RPC_URL=                  # keyed NEAR RPC (FastNEAR, Lava, Infura…); comma-separate several
# Full RPC URLs per chain (comma-separate several). They win over the provider keys above.
RPC_BASE=
RPC_ARBITRUM=
RPC_BSC=
RPC_ROBINHOOD=                 # no Alchemy default — set one for reliable Robinhood Chain trading
RPC_ARC=                       # no Alchemy default — set one for reliable Arc trading
RPC_SOLANA=

# --- Optional ----------------------------------------------------------------
TELEGRAM_BOT_USERNAME=         # bot username for invite links (read from getMe when empty)
ADMIN_TOKEN=                   # bearer token for /api/admin/referral-payouts*
REFERRAL_MIN_PAYOUT_USD=       # minimum referral claim, default 5
LIFI_INTEGRATOR=               # defaults to "hopr"
